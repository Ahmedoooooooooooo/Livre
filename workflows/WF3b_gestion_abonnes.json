{
  "name": "WF3b — Gestion Abonnés Livre&Vous",
  "nodes": [
    {
      "id": "wf3b-save-wh",
      "name": "POST /save-subscriber",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "save-subscriber",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "wf3b-save-subscriber"
    },
    {
      "id": "wf3b-save-code",
      "name": "Sauvegarder Abonné",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nif (!sd.subscribers) sd.subscribers = {};\nconst body = $input.first().json.body || $input.first().json;\nconst email = (body.email || '').toLowerCase().trim();\nif (!email) return [{json:{ok:false, error:'email manquant'}}];\nsd.subscribers[email] = {\n  ...body,\n  email,\n  active: body.active !== false,\n  savedAt: new Date().toISOString()\n};\nreturn [{json:{ok:true, email, total: Object.keys(sd.subscribers).length}}];"
      }
    },
    {
      "id": "wf3b-save-resp",
      "name": "Répondre save",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [{"name": "Access-Control-Allow-Origin", "value": "*"}]
          }
        }
      }
    },
    {
      "id": "wf3b-get-wh",
      "name": "GET /get-subscribers",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 520],
      "parameters": {
        "httpMethod": "GET",
        "path": "get-subscribers",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "wf3b-get-subscribers"
    },
    {
      "id": "wf3b-get-code",
      "name": "Lire Abonnés",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 520],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst all = Object.values(sd.subscribers || {});\nconst actifs = all.filter(s => s.active !== false && s.email && s.prenom);\nreturn [{json:{subscribers: actifs, total: actifs.length}}];"
      }
    },
    {
      "id": "wf3b-get-resp",
      "name": "Répondre abonnés",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 520],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [{"name": "Access-Control-Allow-Origin", "value": "*"}]
          }
        }
      }
    },
    {
      "id": "wf3b-del-wh",
      "name": "POST /deactivate-subscriber",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 740],
      "parameters": {
        "httpMethod": "POST",
        "path": "deactivate-subscriber",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "wf3b-deactivate-subscriber"
    },
    {
      "id": "wf3b-del-code",
      "name": "Désactiver Abonné",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 740],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nif (!sd.subscribers) sd.subscribers = {};\nconst body = $input.first().json.body || $input.first().json;\nconst email = (body.email || '').toLowerCase().trim();\nif (sd.subscribers[email]) {\n  sd.subscribers[email].active = false;\n  sd.subscribers[email].deactivatedAt = new Date().toISOString();\n}\nreturn [{json:{ok:true, email, deactivated: !!sd.subscribers[email]}}];"
      }
    }
  ],
  "connections": {
    "POST /save-subscriber": {
      "main": [[{"node": "Sauvegarder Abonné", "type": "main", "index": 0}]]
    },
    "Sauvegarder Abonné": {
      "main": [[{"node": "Répondre save", "type": "main", "index": 0}]]
    },
    "GET /get-subscribers": {
      "main": [[{"node": "Lire Abonnés", "type": "main", "index": 0}]]
    },
    "Lire Abonnés": {
      "main": [[{"node": "Répondre abonnés", "type": "main", "index": 0}]]
    },
    "POST /deactivate-subscriber": {
      "main": [[{"node": "Désactiver Abonné", "type": "main", "index": 0}]]
    }
  },
  "active": false,
