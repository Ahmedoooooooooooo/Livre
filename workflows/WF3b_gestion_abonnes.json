        }
      }
    },
    {
      "id": "wf3b-hist-add-wh",
      "name": "POST /add-story-history",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 1180],
      "parameters": {
        "httpMethod": "POST",
        "path": "add-story-history",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "wf3b-add-story-history"
    },
    {
      "id": "wf3b-hist-add-code",
      "name": "Ajouter Historique",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 1180],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nif (!sd.storyHistory) sd.storyHistory = {};\nconst body = $input.first().json.body || $input.first().json;\nconst email = (body.email || '').toLowerCase().trim();\nif (!email) return [{json:{ok:false, error:'email manquant'}}];\nif (!sd.storyHistory[email]) sd.storyHistory[email] = [];\nsd.storyHistory[email].push({\n  titre: body.titre || '',\n  theme: body.theme || '',\n  resume: body.resume || '',\n  monthLabel: body.monthLabel || '',\n  addedAt: new Date().toISOString()\n});\nreturn [{json:{ok:true, email, total: sd.storyHistory[email].length}}];"
      }
    },
    {
      "id": "wf3b-theme-set-wh",
      "name": "POST /set-monthly-theme",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 1400],
      "parameters": {
        "httpMethod": "POST",
        "path": "set-monthly-theme",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "wf3b-set-monthly-theme"
    },
    {
      "id": "wf3b-theme-set-code",
      "name": "Définir Thème Mensuel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 1400],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst body = $input.first().json.body || $input.first().json;\nconst now = new Date();\nconst defaultLabel = now.toLocaleDateString('fr-FR', {month:'long', year:'numeric'});\nsd.monthlyTheme = {\n  theme: body.theme || 'Aventure du mois',\n  monthLabel: body.monthLabel || defaultLabel,\n  setAt: new Date().toISOString()\n};\nreturn [{json:{ok:true, ...sd.monthlyTheme}}];"
      }
    },
    {
      "id": "wf3b-theme-get-wh",
      "name": "GET /get-monthly-theme",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 1620],
      "parameters": {
        "httpMethod": "GET",
        "path": "get-monthly-theme",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "wf3b-get-monthly-theme"
    },
    {
      "id": "wf3b-theme-get-code",
      "name": "Lire Thème Mensuel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 1620],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst now = new Date();\nconst defaultLabel = now.toLocaleDateString('fr-FR', {month:'long', year:'numeric'});\nconst themeData = sd.monthlyTheme || {theme: 'Aventure du mois', monthLabel: defaultLabel};\nreturn [{json: themeData}];"
      }
    },
    {
      "id": "wf3b-theme-get-resp",
